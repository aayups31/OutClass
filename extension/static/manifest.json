{
  "manifest_version": 3,
  "name": "OutClass — Udemy learning companion",
  "version": "0.8.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Connect your Udemy lessons with your own local code, notes, and Git checkpoints.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:47831/*",
    "https://*.udemy.com/course/*",
    "https://udemy.com/course/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "OutClass"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.udemy.com/course/*",
        "https://udemy.com/course/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
