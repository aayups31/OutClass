{
  "name": "git-for-learning",
  "version": "0.8.0",
  "description": "A local learning workspace for Udemy, code, and sourced AI help.",
  "author": "Aayu Pratap Singh",
  "main": "dist/desktop/main.cjs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts --dev",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:site": "node scripts/build-site.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "build:ai": "esbuild services/ai/server.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/ai/server.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "desktop": "node scripts/desktop.mjs",
    "package:desktop": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:extension": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-extension.ps1",
    "preview:site": "node scripts/preview-site.mjs",
    "test:desktop": "playwright test --config playwright.desktop.config.ts"
  },
  "build": {
    "appId": "com.gitlearn.workspace",
    "productName": "OutClass",
    "directories": {
      "output": "dist/releases"
    },
    "files": [
      "dist/desktop/**",
      "dist/web/**",
      "dist/site/**",
      "package.json",
      "!**/*.map",
      "!**/.env*"
    ],
    "extraResources": [
      {
        "from": "dist/editor",
        "to": "editor",
        "filter": [
          "*.vsix"
        ]
      },
      {
        "from": "dist/extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis",
      "artifactName": "OutClass-Setup-${version}.${ext}",
      "icon": "extension/static/icons/icon-256.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "aayups31",
      "repo": "OutClass"
    }
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "ignore": "^7.0.5",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "twitter-text": "3.1.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "@vercel/cli-config": {
      "zod": "^4.6.5"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/chrome": "^0.1.25",
    "@types/express": "^5.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/vscode": "^1.140.0",
    "@vercel/functions": "3.10.0",
    "@vscode/vsce": "^4.0.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.12",
    "gsap": "^3.15.0",
    "jsdom": "^29.0.1",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "stripe": "^23.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^5.0.3"
  }
}
